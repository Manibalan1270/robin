# Copy to `.env` and fill in. Never commit `.env`.

# OpenAI key (or any OpenAI-compatible provider - see OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_MODEL_MAIN=gpt-4o-mini

# Optional: use Groq instead of OpenAI
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL_MAIN=llama-3.3-70b-versatile

# Websites allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000
